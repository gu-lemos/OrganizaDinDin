@model RegisterDto
@{
    ViewData["Title"] = "Cadastro";
    Layout = "_AuthLayout";
}

<div class="text-center mb-4">
    <partial name="_AuthLogo" />
    <p class="mb-0 auth-subtitulo">Crie sua conta para começar</p>
</div>

<form method="post" asp-action="Register" class="auth-form" novalidate>
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label small">Nome</label>
        <input asp-for="Nome" class="form-control form-control-lg" placeholder="Seu nome completo" autocomplete="name" data-validar="obrigatorio" />
        <div class="invalid-feedback">Informe seu nome.</div>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label small">Email</label>
        <input asp-for="Email" class="form-control form-control-lg" type="email" placeholder="seu@email.com" autocomplete="email" data-validar="email" />
        <div class="invalid-feedback">Informe um email válido.</div>
    </div>

    <div class="mb-4">
        <label asp-for="Senha" class="form-label small">Senha</label>
        <input asp-for="Senha" class="form-control form-control-lg" placeholder="••••••••" autocomplete="new-password" data-validar="senha" />
        <div class="invalid-feedback">A senha deve ter no mínimo 6 caracteres.</div>
    </div>

    <button type="submit" class="btn btn-brand btn-lg w-100 py-3 fw-semibold" data-carregando="Cadastrando...">Cadastrar</button>

    <p class="text-center mt-4 mb-0">Já tem uma conta? <a class="link-offset-2" asp-action="Login">Fazer login</a></p>
</form>
