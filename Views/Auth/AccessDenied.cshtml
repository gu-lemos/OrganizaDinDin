@{
    ViewData["Title"] = "Acesso negado";
    Layout = "_AuthLayout";
}

<div class="text-center">
    <div class="mb-4">
        <span class="auth-icone-erro"><i class="bi bi-shield-lock"></i></span>
    </div>

    <h2 class="mb-2 auth-logo">Acesso negado</h2>
    <p class="mb-4 auth-subtitulo">Você não tem permissão para acessar esta página.</p>

    <form method="post" asp-action="Logout">
        <button type="submit" class="btn btn-light btn-lg w-100 py-3 fw-semibold">
            <i class="bi bi-box-arrow-right me-2"></i>Sair
        </button>
    </form>
</div>
